[sub_resource type="GDScript" id="GDScript_4ount"]
script/source = "extends Node

@export var levevl: Level
@export var ORDERS: Node2D
@export var order: LevelOrder

func _ready() -> void:
	levevl.has_started = true
	Audio.start_music()
	
	var nodes: Array[Node] = ORDERS.get_children()
	
	for i in 2:
		for node: Node in nodes:
			for b: Node in nodes:
				(b as Node2D).visible = false
				
			(node as Node2D).visible = true
			
			await get_tree().create_timer(0.175).timeout
	
	(nodes[nodes.size() - 1] as Node2D).visible = false
	
	order.visible = true
	
	#
	##await get_tree().create_timer(2.0).timeout
	#
	levevl.anim_level()
"

