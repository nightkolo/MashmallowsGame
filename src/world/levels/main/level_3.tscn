[sub_resource type="GDScript" id="GDScript_0auil"]
script/source = "extends Area2D

@export var g: Node2D

var t: Tween

func _ready() -> void:
	collision_layer = 0
	collision_mask = 2
				   
	body_entered.connect(func(_body: Node2D):
		if t:
			t.kill()
		t = create_tween()
		t.tween_property(g, \"modulate\", Color(Color.WHITE, 1.0), 1.0)
		)
			  
	body_exited.connect(func(_body: Node2D):
		if t:
			t.kill()
		t = create_tween()
		t.tween_property(g, \"modulate\", Color(Color.WHITE, 0.0), 1.0)
		)
"

